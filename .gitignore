# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
# test.yml's `dist` job writes the bill of materials here, alongside
# dist/ above (issue #1166): both are build output, not source
sbom/
*.egg-info/
.installed.cfg
*.egg

# Environments
.env
.venv
env/
envtest/
venv/
ENV/
env.bak/
venv.bak/

# PyInstaller
#  Usually these files are written by a Python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
coverage-data-bindings
coverage-data-no-bindings
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv*/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# vscode: the workspace files are tracked, and the rest of what the editor
# writes there is not. The directory itself cannot be the pattern -- git does
# not descend into an excluded directory, so a negation under `.vscode/` never
# matches -- which is why this excludes the contents and re-admits two names
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# PyCharm
.idea/

# MACOS
.DS_Store
btclib.prof

~*.docx

.pytest_cache/

# cosmic-ray sessions, written into the root by the commands CONTRIBUTING.md
# gives: one row per mutant, so a finished sighash session is 727 verdicts
# and megabytes of them. What is worth keeping is uploaded by the mutation
# workflow as an artifact, where it expires; a session committed here would
# be a snapshot of a suite that has moved on
*.sqlite
