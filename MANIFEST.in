include LICENSE
include COPYRIGHT
include *.md
include *.txt
include *.yaml
include *.jsonc
include pyproject.toml
include uv.lock
include .python-version
# the sdist already carries .pre-commit-config.yaml, which points at this
include .secrets.baseline
# the Jekyll sources of btclib.org, which is served from this repository's
# root, are not named here at all: they are tracked and deliberately absent
# from the sdist, and the list of them lives in [tool.check-manifest]
# ignore. It used to live here, as five exclude rules, and building the
# sdist with and without them showed four matched nothing any include had
# added -- their only effect was on check-manifest, so they were that
# tool's configuration written in another tool's file. The fifth,
# _config.yml, was matched by an "include *.yml" that had no other file to
# match once the read the docs configuration took its canonical dotted
# name, so both that include and the exclude are gone

recursive-include btclib *.csv
recursive-include btclib *.json
recursive-include btclib *.md
recursive-include btclib *.txt
recursive-include btclib *.bin
recursive-include btclib *.typed

recursive-include tests *.bin
recursive-include tests *.csv
recursive-include tests *.json
recursive-include tests *.md
recursive-include tests *.py
recursive-exclude tests *.pyc
recursive-include tests *.txt

recursive-exclude docs/build *
recursive-include docs *.bat
recursive-include docs *.py
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.txt
recursive-include docs Makefile
